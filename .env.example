# Kopiere diese Datei nach .env.local (lokal) bzw. trage die Werte in Vercel ein.
# Schritt-für-Schritt-Anleitung: docs/SETUP.md

# --- App ---------------------------------------------------------------
# Öffentliche Basis-URL ohne Slash am Ende. Lokal: http://localhost:3000
APP_URL=http://localhost:3000

# --- Datenbank (Neon Postgres) ------------------------------------------
# "Pooled connection" (Host enthält "-pooler") für die App
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direkte Verbindung (ohne "-pooler") für Migrationen. Leer lassen = DATABASE_URL wird genutzt.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Google OAuth --------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# --- Zugang --------------------------------------------------------------
# Nur diese Google-Adressen dürfen sich einloggen (kommagetrennt).
ALLOWED_EMAILS=du@gmail.com,deine.freundin@gmail.com

# --- Secrets: mit `npm run gen:keys` erzeugen ----------------------------
# 32 Byte, base64 – verschlüsselt die Google-Tokens in der Datenbank
TOKEN_ENCRYPTION_KEY=
# Schützt den Cron-Endpunkt /api/cron/tick (ab Meilenstein 4)
CRON_SECRET=
# Web Push (ab Meilenstein 6)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@gmail.com

# Event-Quellen (ab Meilenstein 12): Claude liest eure Veranstaltungsseiten.
# Schlüssel aus console.anthropic.com. Ohne Schlüssel ist die Funktion aus.
ANTHROPIC_API_KEY=

# Fotos (ab Meilenstein 9): setzt Vercel automatisch, sobald ein privater Blob Store
# mit dem Projekt verbunden ist. Lokal mit ENABLE_DEV_TOOLS=1 landen Fotos in .data/photos.
# BLOB_READ_WRITE_TOKEN=

# --- Nur für Tests --------------------------------------------------------
# Zeigt in den Einstellungen die Dev-Uhr (Zeit vorstellen, Runden testen).
# ENABLE_DEV_TOOLS=1
# Leitet Calendar-API-Aufrufe an einen Mock-Server um. In Produktion weglassen.
# GOOGLE_API_BASE_URL=http://localhost:4010
# Erlaubt Event-Quellen auf localhost/http (nur mit ENABLE_DEV_TOOLS=1). In Produktion weglassen.
# ALLOW_PRIVATE_EVENT_URLS=1
# Leitet Claude-Aufrufe an einen Mock-Server um. In Produktion weglassen.
# ANTHROPIC_BASE_URL=http://localhost:4030
